{
  "name": "@wherehouse/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "gen:geo": "openapi-typescript ../../apps/fastapi/openapi.json -o src/geo/openapi.generated.ts"
  },
  "dependencies": {
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@wherehouse/auth": "workspace:*",
    "@wherehouse/db": "workspace:*",
    "@wherehouse/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@wherehouse/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:"
  }
}
